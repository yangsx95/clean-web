{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanWeb",
  "version": "0.1.0",
  "identifier": "app.cleanweb.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "title": "CleanWeb", "width": 1180, "height": 760, "minWidth": 980, "minHeight": 680, "visible": false, "dragDropEnabled": false }] },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "家庭网络净化与代理管理工具",
    "longDescription": "CleanWeb 帮助家长通过域名、IP 和订阅规则管理家庭电脑的网络访问。",
    "resources": ["resources/mihomo/*.gz"]
  }
}
