{
  "name": "clean-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 1420",
    "dev:mobile": "vite --config apps/mobile/vite.config.ts --host 127.0.0.1 --port 1421",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "build:mobile": "tsc -p apps/mobile/tsconfig.json && vite build --config apps/mobile/vite.config.ts",
    "test": "vitest run",
    "rules:check": "node scripts/rules/validate-clash-rules.mjs",
    "icons:generate": "scripts/assets/generate-icons.sh",
    "release:bump": "scripts/release/bump-version.sh",
    "release:preflight": "scripts/release/preflight.sh",
    "release:macos:local-dmg": "scripts/release/package-local-macos-dmg.sh",
    "release:macos:verify": "scripts/release/verify-macos-dmg.sh",
    "install:macos:latest": "scripts/install-latest-macos.sh",
    "release:tag": "scripts/release/tag-release.sh",
    "tauri": "node scripts/build/tauri-desktop.mjs",
    "tauri:mobile": "cd apps/mobile && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "jsqr": "1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
